<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/chat_bg">

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/chatToolbar"
        android:layout_width="match_parent" android:layout_height="56dp"
        android:background="@color/surface" android:elevation="1dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent"
            android:orientation="horizontal" android:gravity="center_vertical">
            <ImageButton android:id="@+id/btnBack"
                android:layout_width="44dp" android:layout_height="44dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_back" android:tint="?attr/colorIcon" android:scaleType="center" />
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:orientation="vertical" android:layout_marginStart="8dp">
                <TextView android:id="@+id/tvChatName" android:layout_width="wrap_content"
                    android:layout_height="wrap_content" android:text="联系人" android:textSize="17dp"
                    android:textStyle="bold" android:textColor="@color/text"
                    android:maxLines="1" android:ellipsize="end" />
                <TextView android:id="@+id/tvChatStatus" android:layout_width="wrap_content"
                    android:layout_height="wrap_content" android:text="离线" android:textSize="12dp"
                    android:textColor="@color/text_secondary" />
            </LinearLayout>
            <ImageButton android:id="@+id/btnVoiceCall"
                android:layout_width="40dp" android:layout_height="40dp"
                android:src="@drawable/ic_phone" android:tint="?attr/colorIcon"
                android:scaleType="fitCenter" android:padding="8dp"
                android:background="?attr/selectableItemBackgroundBorderless" />
            <ImageButton android:id="@+id/btnVideoCall"
                android:layout_width="40dp" android:layout_height="40dp"
                android:src="@drawable/ic_video" android:tint="?attr/colorIcon"
                android:scaleType="fitCenter" android:padding="8dp"
                android:background="?attr/selectableItemBackgroundBorderless" />
        </LinearLayout>
    </androidx.appcompat.widget.Toolbar>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvMessages"
        android:layout_width="match_parent" android:layout_height="0dp"
        android:layout_weight="1" android:padding="12dp" android:clipToPadding="false" />

    <LinearLayout android:id="@+id/layoutInput"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:background="@color/surface"
        android:padding="6dp" android:gravity="center_vertical">
        <ImageButton android:id="@+id/btnVoiceToggle"
            android:layout_width="36dp" android:layout_height="36dp"
            android:src="@drawable/ic_voice" android:tint="?attr/colorIcon"
            android:scaleType="fitCenter" android:padding="4dp"
            android:background="?attr/selectableItemBackgroundBorderless" />
        <EditText android:id="@+id/etMessage"
            android:layout_width="0dp" android:layout_height="40dp" android:layout_weight="1"
            android:background="@drawable/bg_chat_input" android:hint="输入消息"
            android:paddingStart="14dp" android:paddingEnd="14dp" android:textSize="15dp"
            android:maxLines="4" android:inputType="textMultiLine" />
        <TextView android:id="@+id/btnHoldTalk"
            android:layout_width="0dp" android:layout_height="40dp" android:layout_weight="1"
            android:gravity="center" android:text="按住 说话" android:textSize="15dp"
            android:textColor="@color/text_secondary" android:background="@drawable/bg_chat_input"
            android:visibility="gone" />
        <ImageButton android:id="@+id/btnPlus"
            android:layout_width="36dp" android:layout_height="36dp"
            android:src="@drawable/ic_plus" android:tint="?attr/colorIcon"
            android:scaleType="fitCenter" android:padding="4dp"
            android:background="?attr/selectableItemBackgroundBorderless" />
        <Button
            android:id="@+id/btnSend"
            android:layout_width="56dp" android:layout_height="40dp"
            android:text="发送" android:textColor="@color/white" android:textSize="14dp"
            android:background="@drawable/bg_send_btn"
            android:layout_marginStart="6dp" />
    </LinearLayout>

    <!-- 密语式"+"面板：默认隐藏，在输入栏下方弹出，把输入栏像键盘一样顶上去 -->
    <LinearLayout android:id="@+id/plusPanel"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:background="@color/panel_bg"
        android:visibility="gone">
        <View android:layout_width="match_parent" android:layout_height="1dp"
            android:background="@color/border" />
        <android.widget.GridLayout
            android:id="@+id/plusGrid"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:columnCount="4"
            android:paddingStart="10dp" android:paddingEnd="10dp"
            android:paddingTop="16dp" android:paddingBottom="20dp" />
    </LinearLayout>
</LinearLayout>
