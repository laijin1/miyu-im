<?xml version="1.0" encoding="utf-8"?>
<!--
  通话应用内浮层（CallOverlayView 的内容布局）。

  由 CallOverlayView 用 LayoutInflater.from(ctx).inflate(R.layout.call_overlay_view, this)
  inflate 到自身（一个 FrameLayout 子类）里，再 addView 到宿主 Activity 的 android.R.id.content。

  三个渲染目标（与 activity_call.xml 同构，接 CallEngine）：
    overlayRemoteVideo         ImageView   远端帧        ← CallEngine.setRelayRemoteView
    overlayLocalPreviewView    TextureView 相机锚点      ← CallEngine.setRendererViews(.., .., 本View, ..)
    overlayLocalPreviewFrame   ImageView   本地预览显示层 ← 同上

  ⚠️ overlayLocalPreviewView 是相机唯一的 preview surface，同一时刻只能挂一个 window；
     本浮层与通话页之间切换靠 WebRTCManager.setRelayLocalPreviewView 的 re-arm（摘旧挂新）。

  ⚠️ 尺寸（120dp × 160dp）是初版，真机可调。
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/callOverlayRoot"
    android:layout_width="120dp"
    android:layout_height="160dp"
    android:background="@drawable/bg_call_overlay">

    <!-- ===== 远端画面（底层，接 relay 远端帧） ===== -->
    <ImageView
        android:id="@+id/overlayRemoteVideo"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:contentDescription="@null" />

    <!-- ===== 本地自视小窗（右下角，抬到按钮条之上避免被挡） =====
         marginBottom 34dp = 底部按钮条高度(26dp) + 上下 padding，避免压住按钮。 -->
    <FrameLayout
        android:id="@+id/overlayLocalContainer"
        android:layout_width="40dp"
        android:layout_height="54dp"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="4dp"
        android:layout_marginBottom="34dp">

        <!-- 相机帧锚点：持有真实 SurfaceTexture，保证相机回调稳定出帧 -->
        <TextureView
            android:id="@+id/overlayLocalPreviewView"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <!-- 本地画面实际显示层：centerCrop 填满，原比例不变形 -->
        <ImageView
            android:id="@+id/overlayLocalPreviewFrame"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:contentDescription="@null" />
    </FrameLayout>

    <!-- ===== 顶部信息条：昵称 + 计时 ===== -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:orientation="vertical"
        android:background="#66000000"
        android:paddingStart="6dp"
        android:paddingEnd="6dp"
        android:paddingTop="3dp"
        android:paddingBottom="3dp">

        <TextView
            android:id="@+id/overlayName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="联系人"
            android:textSize="11sp"
            android:textColor="#FFFFFFFF"
            android:singleLine="true"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/overlayTimer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="00:00"
            android:textSize="10sp"
            android:textColor="#FFAAAAAA"
            android:singleLine="true" />
    </LinearLayout>

    <!-- ===== 底部按钮条：闭麦 / 静音对方 / 挂断 / 放大回通话页 =====
         26dp × 4 = 104dp + 3×2dp 间距 = 110dp，加左右 2dp padding = 114dp ≤ 120dp。
         按钮是 clickable 的 ImageButton，会先消费自己的点击，不会触发根 View 的"放大"。 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:orientation="horizontal"
        android:gravity="center"
        android:background="#66000000"
        android:paddingStart="2dp"
        android:paddingEnd="2dp"
        android:paddingTop="2dp"
        android:paddingBottom="2dp">

        <ImageButton
            android:id="@+id/overlayBtnMute"
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:src="@drawable/ic_mic"
            android:scaleType="fitCenter"
            android:padding="5dp"
            android:background="@drawable/bg_call_control"
            android:contentDescription="闭麦" />

        <ImageButton
            android:id="@+id/overlayBtnLocalMute"
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:layout_marginStart="2dp"
            android:src="@drawable/ic_volume_off"
            android:tint="@android:color/white"
            android:scaleType="fitCenter"
            android:padding="5dp"
            android:background="@drawable/bg_call_control"
            android:contentDescription="静音对方" />

        <ImageButton
            android:id="@+id/overlayBtnHangup"
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:layout_marginStart="2dp"
            android:src="@drawable/ic_hangup"
            android:scaleType="fitCenter"
            android:padding="5dp"
            android:background="@drawable/bg_call_hangup"
            android:contentDescription="挂断" />

        <!-- 放大回通话页。图标暂用 ic_resize_handle（白色斜向扩散线），
             比 ic_switch_camera 更贴近"放大"语义 —— 后者在本批已是通话页右上角
             的"切摄像头"图标，复用会造成两处同图不同义。本批不新增图标。 -->
        <ImageButton
            android:id="@+id/overlayBtnExpand"
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:layout_marginStart="2dp"
            android:src="@drawable/ic_resize_handle"
            android:scaleType="fitCenter"
            android:padding="5dp"
            android:background="@drawable/bg_call_control"
            android:contentDescription="放大" />
    </LinearLayout>
</FrameLayout>
