<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <androidx.media3.ui.PlayerView
        android:id="@+id/pvChatVideo"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#000000" />

    <!-- 返回按钮：半透明圆底白箭头 -->
    <ImageButton
        android:id="@+id/btnChatVideoBack"
        android:layout_width="44dp" android:layout_height="44dp"
        android:layout_gravity="start|top"
        android:layout_marginStart="12dp" android:layout_marginTop="16dp"
        android:background="@drawable/bg_play_overlay"
        android:src="@drawable/ic_back"
        android:tint="#FFFFFF"
        android:scaleType="center"
        android:contentDescription="返回" />
</FrameLayout>
