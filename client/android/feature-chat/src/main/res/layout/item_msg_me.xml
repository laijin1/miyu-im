<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="end"
    android:paddingLeft="12dp" android:paddingRight="12dp"
    android:paddingTop="4dp" android:paddingBottom="4dp">

    <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:orientation="vertical" android:gravity="end">
        <FrameLayout android:id="@+id/ivMsgImageWrap"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:visibility="gone">
            <ImageView android:id="@+id/ivMsgImage"
                android:layout_width="150dp" android:layout_height="150dp"
                android:scaleType="centerCrop" />
            <!-- 视频消息中央播放按钮 -->
            <TextView android:id="@+id/tvMsgPlay"
                android:layout_width="44dp" android:layout_height="44dp"
                android:layout_gravity="center"
                android:gravity="center"
                android:text="▶" android:textSize="20dp"
                android:textColor="#FFFFFF"
                android:background="@drawable/bg_play_overlay"
                android:visibility="gone" />
        </FrameLayout>
        <TextView android:id="@+id/tvMsgText"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:maxWidth="260dp" android:background="@drawable/bg_msg_me"
            android:paddingLeft="14dp" android:paddingRight="14dp"
            android:paddingTop="12dp" android:paddingBottom="12dp"
            android:textSize="15dp" android:textColor="@color/bubble_text_self"
            android:lineSpacingExtra="4dp" android:layout_marginStart="8dp" />
        <!-- 转账卡片（密语橙色，我发的） -->
        <LinearLayout android:id="@+id/llTransferCard"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:orientation="horizontal" android:gravity="center_vertical"
            android:background="@drawable/bg_transfer_card"
            android:paddingLeft="14dp" android:paddingRight="14dp"
            android:paddingTop="10dp" android:paddingBottom="10dp"
            android:visibility="gone">
            <TextView android:id="@+id/tvTransferAmount"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:textSize="20dp" android:textStyle="bold" android:textColor="#FFFFFF"
                android:text="¥0.00" />
            <View android:layout_width="1dp" android:layout_height="30dp" android:background="#33FFFFFF"
                android:layout_marginLeft="12dp" android:layout_marginRight="12dp" />
            <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:orientation="vertical">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="转账" android:textSize="14dp" android:textStyle="bold"
                    android:textColor="#FFFFFF" />
                <TextView android:id="@+id/tvTransferStatus"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="待收款" android:textSize="11dp" android:textColor="#CCFFFFFF" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <ImageView android:id="@+id/ivMsgAvatar"
        android:layout_width="36dp" android:layout_height="36dp"
        android:src="@drawable/ic_avatar_placeholder"
        android:scaleType="centerCrop" android:layout_marginStart="8dp" />
</LinearLayout>
