<?xml version="1.0" encoding="utf-8"?>
<!-- :feature-wallet 钱包功能模块清单（activity 全部用全限定名） -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application>
        <activity
            android:name="com.familychat.app.ui.WalletActivity"
            android:exported="false"
            android:screenOrientation="portrait" />
        <activity
            android:name="com.familychat.app.ui.PayCodeActivity"
            android:exported="false"
            android:screenOrientation="portrait" />
        <activity
            android:name="com.familychat.app.ui.ScanPayActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name="com.familychat.app.ui.ChargeRequestActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name="com.familychat.app.ui.ChargeConfirmActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.AppCompat.Dialog" />
        <activity
            android:name="com.familychat.app.ui.PasswordInputActivity"
            android:exported="false"
            android:screenOrientation="portrait" />
        <activity
            android:name="com.familychat.app.ui.PaymentSuccessActivity"
            android:exported="false"
            android:screenOrientation="portrait" />
        <activity
            android:name="com.familychat.app.ui.TransferSendActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name="com.familychat.app.ui.TransferDetailActivity"
            android:exported="false"
            android:screenOrientation="portrait" />
        <activity
            android:name="com.familychat.app.ui.BillsActivity"
            android:exported="false"
            android:screenOrientation="portrait" />
    </application>
</manifest>
