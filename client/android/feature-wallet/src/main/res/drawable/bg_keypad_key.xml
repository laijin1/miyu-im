<?xml version="1.0" encoding="utf-8"?>
<!-- 数字键盘按键：白天白底按压浅灰，黑夜深底（颜色资源随模式切换） -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape><solid android:color="@color/keypad_key_pressed" /></shape>
    </item>
    <item>
        <shape><solid android:color="@color/keypad_key_bg" /></shape>
    </item>
</selector>
