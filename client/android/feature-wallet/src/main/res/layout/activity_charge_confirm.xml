<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:orientation="vertical" android:background="@color/surface">

    <!-- 标题 -->
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="22dp" android:text="收款请求" android:textSize="16sp"
        android:textStyle="bold" android:textColor="@color/text" android:gravity="center" />

    <!-- 商家信息 -->
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="18dp" android:orientation="horizontal" android:gravity="center_vertical"
        android:paddingLeft="28dp" android:paddingRight="28dp">
        <TextView android:id="@+id/tvChargeConfirmAvatar" android:layout_width="44dp" android:layout_height="44dp"
            android:textSize="20sp" android:textColor="#FFFFFF" android:gravity="center"
            android:background="@drawable/bg_avatar_circle" android:text="?" />
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:layout_marginLeft="12dp" android:orientation="vertical">
            <TextView android:id="@+id/tvChargeConfirmName" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:textSize="15sp" android:textStyle="bold" android:textColor="@color/text" android:text="商家" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginTop="1dp" android:text="请求向你收款" android:textSize="12sp"
                android:textColor="@color/text_secondary" />
        </LinearLayout>
    </LinearLayout>

    <!-- 金额 -->
    <TextView android:id="@+id/tvChargeConfirmAmount" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="20dp" android:text="¥0.00" android:textSize="30sp" android:textStyle="bold"
        android:textColor="@color/text" android:gravity="center" />

    <!-- 备注 -->
    <TextView android:id="@+id/tvChargeConfirmMemo" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="8dp" android:text="" android:textSize="13sp"
        android:textColor="@color/text_secondary" android:gravity="center"
        android:visibility="gone" />

    <!-- 按钮区 -->
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="24dp" android:orientation="horizontal">
        <TextView android:id="@+id/btnChargeConfirmDecline" android:layout_width="0dp" android:layout_height="46dp"
            android:layout_weight="1" android:text="拒绝" android:textSize="15sp"
            android:textColor="@color/text_secondary" android:gravity="center"
            android:background="?attr/selectableItemBackground" />
        <TextView android:layout_width="1dp" android:layout_height="match_parent" android:background="@color/border" />
        <TextView android:id="@+id/btnChargeConfirmOk" android:layout_width="0dp" android:layout_height="46dp"
            android:layout_weight="1" android:text="确认付款" android:textSize="15sp" android:textStyle="bold"
            android:textColor="@color/wallet_green" android:gravity="center"
            android:background="?attr/selectableItemBackground" />
    </LinearLayout>
</LinearLayout>
