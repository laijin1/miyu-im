<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:background="@color/bg">

    <!-- 顶栏 -->
    <LinearLayout android:layout_width="match_parent" android:layout_height="46dp"
        android:orientation="horizontal" android:gravity="center_vertical" android:background="@color/surface">
        <TextView android:id="@+id/btnBillsBack" android:layout_width="40dp" android:layout_height="match_parent"
            android:text="‹" android:textSize="26dp" android:textColor="@color/text"
            android:gravity="center" android:background="?attr/selectableItemBackgroundBorderless" />
        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:text="钱包账单" android:textSize="17dp" android:textStyle="bold"
            android:textColor="@color/text" android:gravity="center" />
        <TextView android:layout_width="40dp" android:layout_height="match_parent" />
    </LinearLayout>

    <androidx.recyclerview.widget.RecyclerView android:id="@+id/rvBills" android:layout_width="match_parent" android:layout_height="0dp"
        android:layout_weight="1" android:clipToPadding="false" android:paddingTop="6dp" />

    <TextView android:id="@+id/tvBillsEmpty" android:layout_width="match_parent" android:layout_height="0dp"
        android:layout_weight="1" android:text="暂无账单记录" android:textSize="14sp"
        android:textColor="@color/text_secondary" android:gravity="center"
        android:visibility="gone" />
</LinearLayout>
