<?xml version="1.0" encoding="utf-8"?>
<!--
  换机迁移 · 导入时输入迁移口令（导入页使用）。

  ⚠️ 本页无法知道正确口令的末 4 位是什么 —— 二维码里不含任何口令派生信息
     （把末 4 位写进二维码会削弱口令强度）。所以这里只提示用户去
     **导出设备**的页面上核对「口令末 4 位」，绝不显示"应为 XXXX"。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingLeft="24dp"
    android:paddingRight="24dp"
    android:paddingTop="8dp"
    android:paddingBottom="8dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="13sp"
        android:lineSpacingExtra="4dp"
        android:textColor="@color/text"
        android:text="请输入旧设备导出二维码时设置的迁移口令。它可以与登录密码不同。" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:textSize="12sp"
        android:lineSpacingExtra="4dp"
        android:textColor="@color/text_secondary"
        android:text="口令不会离开本机，只用于本地解密；服务端与本应用都不会保存它。\n如果记不清，请回到旧设备导出页查看「口令末 4 位」再核对。" />

    <EditText
        android:id="@+id/etImportTransferPassword"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:hint="迁移口令"
        android:inputType="textPassword"
        android:maxLines="1"
        android:singleLine="true"
        android:textColor="@color/text"
        android:textColorHint="@color/text_secondary"
        android:importantForAutofill="no" />
</LinearLayout>
