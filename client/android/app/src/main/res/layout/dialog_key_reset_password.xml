<?xml version="1.0" encoding="utf-8"?>
<!--
  重置密钥 · 登录密码输入（第 5 步）。
  用途：用登录密码把新密钥加密后覆盖服务端的「密码加密备份」，
  否则服务端仍存着旧密钥的备份，用户一旦退出登录/清数据，重置会被静默撤销。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingLeft="24dp"
    android:paddingRight="24dp"
    android:paddingTop="8dp"
    android:paddingBottom="8dp">

    <TextView
        android:id="@+id/tvResetPwdPrompt"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="13sp"
        android:lineSpacingExtra="4dp"
        android:textColor="@color/text"
        android:text="请输入登录密码" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:textSize="12sp"
        android:lineSpacingExtra="4dp"
        android:textColor="@color/text_secondary"
        android:text="为什么需要密码：本应用会在服务端保存一份「用登录密码加密的私钥备份」，用于重装后找回。重置密钥后必须用它重新加密该备份，否则下次退出登录或清除数据时，旧密钥会被自动恢复回来，本次重置就白做了。\n\n密码不会离开本机，只用于本地加密；服务端只拿到解不开的密文。" />

    <EditText
        android:id="@+id/etResetPassword"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:hint="登录密码"
        android:inputType="textPassword"
        android:maxLines="1"
        android:singleLine="true"
        android:textColor="@color/text"
        android:textColorHint="@color/text_secondary"
        android:importantForAutofill="no" />
</LinearLayout>
