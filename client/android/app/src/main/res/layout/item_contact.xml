<?xml version="1.0" encoding="utf-8"?>
<!-- QQ 联系人页好友行：圆形头像 + 昵称 + 副标题（备注/个性签名） + 在线点 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="60dp"
    android:orientation="horizontal" android:gravity="center_vertical"
    android:paddingLeft="16dp" android:paddingRight="16dp"
    android:background="?attr/selectableItemBackground">

    <ImageView android:id="@+id/ivContactAvatar"
        android:layout_width="42dp" android:layout_height="42dp"
        android:src="@drawable/ic_avatar_placeholder"
        android:scaleType="centerCrop" android:layout_marginEnd="14dp" />

    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
        android:layout_weight="1" android:orientation="vertical">

        <TextView android:id="@+id/tvContactName"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:textSize="16sp" android:textColor="@color/text"
            android:maxLines="1" android:ellipsize="end" />

        <TextView android:id="@+id/tvContactSub"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:textSize="12sp" android:textColor="@color/text_secondary"
            android:maxLines="1" android:ellipsize="end"
            android:layout_marginTop="2dp" android:visibility="gone" />
    </LinearLayout>

    <View android:id="@+id/vOnlineDot"
        android:layout_width="8dp" android:layout_height="8dp"
        android:background="@drawable/dot_online" android:visibility="gone" />
</LinearLayout>
