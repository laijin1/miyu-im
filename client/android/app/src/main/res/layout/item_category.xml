<?xml version="1.0" encoding="utf-8"?>
<!-- 金刚区分类宫格：彩色圆角块（代码设色）+ 首字 + 名称 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/llCategory"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:orientation="vertical" android:gravity="center_horizontal"
    android:paddingTop="8dp" android:paddingBottom="8dp"
    android:background="?attr/selectableItemBackground">

    <TextView android:id="@+id/tvCategoryIcon"
        android:layout_width="42dp" android:layout_height="42dp"
        android:gravity="center" android:textColor="@android:color/white"
        android:textSize="20sp" android:textStyle="bold" />

    <TextView android:id="@+id/tvCategoryName"
        android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_marginTop="4dp" android:textSize="11sp"
        android:textColor="@color/text" android:maxLines="1" />
</LinearLayout>
