<?xml version="1.0" encoding="utf-8"?>
<!--
  换机迁移 · 迁移口令设置（导出页使用）。

  为什么要有这个口令：二维码一旦被拍照，攻击者可以离线无限次尝试。
  本口令经 PBKDF2-HMAC-SHA256(21 万次) 派生出 AES-256-GCM 密钥，
  没有口令就解不开二维码里的私钥。

  ⚠️ 口令不落盘、不进 Intent、不打日志；App 不留任何找回途径，
     所以弹窗里必须把"忘记 = 永久无法恢复"讲在最显眼处。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingLeft="24dp"
    android:paddingRight="24dp"
    android:paddingTop="8dp"
    android:paddingBottom="8dp">

    <!-- 不可折叠的红字警告：这是用户唯一一次看到"忘记口令的后果"的机会 -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="13sp"
        android:lineSpacingExtra="4dp"
        android:textStyle="bold"
        android:textColor="@color/red"
        android:text="⚠️ 请记牢这个口令，忘记则二维码永久无法恢复。\n本应用不会保存它，服务端也拿不到，没有任何找回途径。" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:textSize="12sp"
        android:lineSpacingExtra="4dp"
        android:textColor="@color/text_secondary"
        android:text="为什么需要口令：二维码里装的是经过口令加密的私钥。只有输入了正确口令的新设备才能导入它；拍到二维码的人没有口令也解不开。\n\n建议 12 位以上，混合大小写字母与数字（最低 8 位）。" />

    <EditText
        android:id="@+id/etTransferPassword"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:hint="设置迁移口令（至少 8 位）"
        android:inputType="textPassword"
        android:maxLines="1"
        android:singleLine="true"
        android:textColor="@color/text"
        android:textColorHint="@color/text_secondary"
        android:importantForAutofill="no" />

    <EditText
        android:id="@+id/etTransferPasswordConfirm"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:hint="再输入一次"
        android:inputType="textPassword"
        android:maxLines="1"
        android:singleLine="true"
        android:textColor="@color/text"
        android:textColorHint="@color/text_secondary"
        android:importantForAutofill="no" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:textSize="12sp"
        android:lineSpacingExtra="4dp"
        android:textColor="@color/text_secondary"
        android:text="生成后本页会显示口令末 4 位，供你在新设备上核对输入是否正确。\n这是迁移专用口令，可以与登录密码不同。" />
</LinearLayout>
