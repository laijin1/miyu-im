<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="60dp"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingLeft="16dp" android:paddingRight="16dp"
    android:background="?attr/selectableItemBackground">

    <ImageView android:id="@+id/ivReqAvatar"
        android:layout_width="44dp" android:layout_height="44dp"
        android:src="@drawable/ic_avatar_placeholder"
        android:scaleType="centerCrop" android:layout_marginEnd="12dp" />

    <TextView android:id="@+id/tvReqName"
        android:layout_width="0dp" android:layout_height="wrap_content"
        android:layout_weight="1" android:text="请求者" android:textSize="16dp"
        android:textStyle="bold" />

    <Button android:id="@+id/btnAccept"
        android:layout_width="wrap_content" android:layout_height="36dp"
        android:text="接受" android:textSize="13dp"
        android:backgroundTint="@color/green" android:textColor="@color/white" />

    <Button android:id="@+id/btnReject"
        android:layout_width="wrap_content" android:layout_height="36dp"
        android:text="拒绝" android:textSize="13dp"
        android:backgroundTint="@color/reject_bg" android:textColor="@color/text_secondary"
        android:layout_marginStart="8dp" />
</LinearLayout>
