<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content" android:layout_height="wrap_content"
    android:orientation="vertical" android:background="@color/surface"
    android:padding="2dp" android:layout_margin="2dp">

    <ImageView android:id="@+id/ivCover" android:layout_width="112dp"
        android:layout_height="112dp" android:scaleType="centerCrop"
        android:background="@color/chat_bg" />

    <LinearLayout android:layout_width="112dp" android:layout_height="wrap_content"
        android:orientation="vertical" android:paddingTop="6dp" android:paddingBottom="6dp">
        <TextView android:id="@+id/tvName" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:textSize="13sp"
            android:textColor="@color/text" android:maxLines="1" android:ellipsize="end" />
        <TextView android:id="@+id/tvCount" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:textSize="11sp"
            android:textColor="@color/text_secondary" />
    </LinearLayout>
</LinearLayout>
