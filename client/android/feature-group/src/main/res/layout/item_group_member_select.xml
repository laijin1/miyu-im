<?xml version="1.0" encoding="utf-8"?>
<!-- 建群/拉人时选择联系人的行：头像 + 昵称 + 选中圈 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="56dp"
    android:orientation="horizontal" android:gravity="center_vertical"
    android:background="?attr/selectableItemBackground"
    android:paddingLeft="16dp" android:paddingRight="16dp">

    <ImageView android:id="@+id/ivSelectAvatar"
        android:layout_width="40dp" android:layout_height="40dp"
        android:src="@drawable/ic_avatar_placeholder"
        android:scaleType="centerCrop" android:layout_marginEnd="12dp" />

    <TextView android:id="@+id/tvSelectName"
        android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
        android:text="好友" android:textSize="16dp" android:textColor="@color/text"
        android:maxLines="1" android:ellipsize="end" />

    <ImageView android:id="@+id/ivSelectCheck"
        android:layout_width="22dp" android:layout_height="22dp"
        android:src="@drawable/ic_check_off" />
</LinearLayout>
