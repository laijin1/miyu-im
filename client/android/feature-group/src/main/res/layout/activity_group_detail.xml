<?xml version="1.0" encoding="utf-8"?>
<!--
  群聊详情（成员管理）：资料卡 + 成员卡 + 底部操作卡。
  id 与控件类型全部沿用改造前（findViewById 契约不变）：
  chatToolbar / btnBack / tvTitle / btnAdd / ivGroupAvatar / tvGroupName /
  tvGroupCount / rvGroupMembers / btnEditNickname / btnTransfer / btnLeaveGroup。
  底部操作改为「卡片列表式」（微信 / Telegram 风格）：一张深灰圆角卡内垂直排列
  三个操作行，1dp 细分割线分隔；常规项左对齐 + 右侧 chevron，危险项（解散/退出）
  居中显示危险红。控件仍用 AppCompatButton（Activity 将 btnTransfer/btnLeaveGroup
  声明为 Button，改成 TextView 会破坏 findViewById 契约），但外观已完全列表化。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:background="@color/bg">

    <!-- ═══ ① 顶栏（id 原样）═══ -->
    <androidx.appcompat.widget.Toolbar
        android:id="@+id/chatToolbar"
        android:layout_width="match_parent" android:layout_height="@dimen/toolbar_height"
        android:background="@color/surface" android:elevation="2dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent"
            android:orientation="horizontal" android:gravity="center_vertical">
            <ImageButton android:id="@+id/btnBack"
                android:layout_width="44dp" android:layout_height="44dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_back" android:tint="?attr/colorIcon" android:scaleType="center" />
            <TextView android:id="@+id/tvTitle"
                android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                android:text="群聊详情" android:textSize="@dimen/text_size_title" android:textStyle="bold"
                android:textColor="@color/text" />
            <ImageButton android:id="@+id/btnAdd"
                android:layout_width="40dp" android:layout_height="40dp"
                android:src="@drawable/ic_add" android:tint="@color/green"
                android:scaleType="fitCenter" android:padding="8dp"
                android:background="?attr/selectableItemBackgroundBorderless" />
        </LinearLayout>
    </androidx.appcompat.widget.Toolbar>

    <!-- ═══ ② 群资料卡 ═══ -->
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:gravity="center_vertical"
        android:background="@drawable/bg_ff_card"
        android:layout_marginStart="@dimen/spacing_m" android:layout_marginEnd="@dimen/spacing_m"
        android:layout_marginTop="@dimen/spacing_m"
        android:padding="@dimen/card_padding">

        <ImageView android:id="@+id/ivGroupAvatar"
            android:layout_width="56dp" android:layout_height="56dp"
            android:src="@drawable/ic_group" android:scaleType="centerCrop" />

        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:orientation="vertical"
            android:layout_marginStart="@dimen/spacing_m">
            <!-- 群主点击改名（Activity 不改：设置 setOnClickListener） -->
            <TextView android:id="@+id/tvGroupName"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="群聊" android:textSize="18sp" android:textStyle="bold"
                android:textColor="@color/text" android:maxLines="1" android:ellipsize="end" />
            <TextView android:id="@+id/tvGroupCount"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="" android:textSize="@dimen/text_size_caption"
                android:textColor="@color/text_secondary"
                android:layout_marginTop="2dp" />
        </LinearLayout>
    </LinearLayout>

    <!-- ═══ ③ 成员卡（RecyclerView 在卡片内部滚动；保持 weight=1）═══ -->
    <LinearLayout android:layout_width="match_parent" android:layout_height="0dp"
        android:layout_weight="1" android:orientation="vertical"
        android:background="@drawable/bg_ff_card"
        android:layout_marginStart="@dimen/spacing_m" android:layout_marginEnd="@dimen/spacing_m"
        android:layout_marginTop="@dimen/spacing_m" android:layout_marginBottom="@dimen/spacing_m"
        android:clipToPadding="false">

        <!-- 标题行：纯静态文案（不设 id，Activity 不引用，避免新增任何 id）。
             人数已由上方资料卡的 tvGroupCount 显示，此处不重复。 -->
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="群成员" android:textSize="@dimen/text_size_caption"
            android:textColor="@color/text_secondary"
            android:paddingStart="@dimen/spacing_l" android:paddingEnd="@dimen/spacing_l"
            android:paddingTop="@dimen/spacing_m" android:paddingBottom="@dimen/spacing_xs" />

        <View android:layout_width="match_parent" android:layout_height="@dimen/divider_height"
            android:layout_marginStart="@dimen/spacing_l" android:background="@color/divider" />

        <androidx.recyclerview.widget.RecyclerView android:id="@+id/rvGroupMembers"
            android:layout_width="match_parent" android:layout_height="0dp"
            android:layout_weight="1" android:clipToPadding="false" />
    </LinearLayout>

    <!-- ═══ ④ 底部操作卡：卡片列表式（不做三个独立大按钮） ═══
         MaterialCardView 负责 #2C2C2E 深灰底、12dp 圆角和内容裁剪；
         行内按压涟漪与 1dp 分割线由行背景 drawable 提供。 -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/spacing_m" android:layout_marginEnd="@dimen/spacing_m"
        android:layout_marginBottom="@dimen/spacing_l"
        app:cardBackgroundColor="@color/action_card_bg"
        app:cardCornerRadius="@dimen/radius_l"
        app:cardElevation="0dp"
        app:strokeWidth="0dp">

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- 常规项：修改我的群名片（左对齐 + chevron） -->
            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnEditNickname"
                style="@style/Widget.FF.ActionRow.Divider"
                android:layout_width="match_parent"
                android:layout_height="@dimen/row_height"
                android:text="修改我的群名片" />

            <!-- 仅群主可见（Activity 用 setVisibility 切换，属性必须是 visibility）。
                 分割线写在本行背景里，行 GONE 时连线一起消失，不会出现双线。 -->
            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnTransfer"
                style="@style/Widget.FF.ActionRow.Divider"
                android:layout_width="match_parent"
                android:layout_height="@dimen/row_height"
                android:visibility="gone"
                android:text="转让群主" />

            <!-- 危险项：Activity 会 setText 切成"解散群聊"/"退出群聊"，
                 文案不固定；居中显示，不加 chevron。 -->
            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnLeaveGroup"
                style="@style/Widget.FF.ActionRow.Danger"
                android:layout_width="match_parent"
                android:layout_height="@dimen/row_height"
                android:text="退出群聊" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>
</LinearLayout>
