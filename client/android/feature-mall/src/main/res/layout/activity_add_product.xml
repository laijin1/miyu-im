<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:background="@color/bg">

    <!-- 顶栏 -->
    <LinearLayout android:layout_width="match_parent" android:layout_height="52dp"
        android:orientation="horizontal" android:gravity="center_vertical"
        android:background="@color/surface">
        <ImageButton android:id="@+id/btnAddBack"
            android:layout_width="40dp" android:layout_height="40dp"
            android:src="@drawable/ic_back" android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="返回" />
        <TextView android:id="@+id/tvAddTitle" android:layout_width="0dp"
            android:layout_height="wrap_content" android:layout_weight="1"
            android:text="发布商品" android:textSize="17sp"
            android:textColor="@color/text" android:gravity="center" />
        <View android:layout_width="40dp" android:layout_height="40dp" />
    </LinearLayout>

    <ScrollView android:layout_width="match_parent" android:layout_height="0dp"
        android:layout_weight="1" android:overScrollMode="never">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:padding="10dp">

            <!-- 商品图片选择 -->
            <FrameLayout android:id="@+id/frmAddImage"
                android:layout_width="match_parent" android:layout_height="170dp"
                android:background="@drawable/bg_dash_border" android:clickable="true"
                android:focusable="true" android:layout_marginBottom="10dp">

                <!-- 圆角预览图（选图后显示，盖住虚线框） -->
                <FrameLayout android:id="@+id/frmAddImageWrap"
                    android:layout_width="match_parent" android:layout_height="match_parent"
                    android:background="@drawable/bg_product_img" android:padding="4dp"
                    android:visibility="gone">
                    <ImageView android:id="@+id/ivAddImage" android:layout_width="match_parent"
                        android:layout_height="match_parent" android:scaleType="centerCrop" />
                </FrameLayout>

                <!-- 空态：图库图标 + 提示 -->
                <LinearLayout android:id="@+id/llAddImageHint" android:layout_width="wrap_content"
                    android:layout_height="wrap_content" android:layout_gravity="center"
                    android:orientation="vertical" android:gravity="center">
                    <ImageView android:layout_width="40dp" android:layout_height="40dp"
                        android:src="@drawable/ic_gallery" android:contentDescription="选择图片" />
                    <TextView android:id="@+id/tvAddImageHint" android:layout_width="wrap_content"
                        android:layout_height="wrap_content" android:text="点击选择商品图片"
                        android:textSize="13sp" android:textColor="@color/text_secondary"
                        android:layout_marginTop="8dp" />
                </LinearLayout>

                <!-- 更换角标（选图后显示） -->
                <TextView android:id="@+id/tvAddChange" android:layout_width="wrap_content"
                    android:layout_height="wrap_content" android:layout_gravity="top|end"
                    android:text="更换" android:textSize="12sp" android:textColor="#FFFFFF"
                    android:paddingLeft="12dp" android:paddingTop="4dp" android:paddingRight="12dp"
                    android:paddingBottom="4dp" android:background="@drawable/bg_taobao_btn"
                    android:layout_marginTop="10dp" android:layout_marginEnd="10dp"
                    android:visibility="gone" />
            </FrameLayout>

            <!-- 基本信息 -->
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:background="@color/surface"
                android:paddingLeft="14dp" android:paddingRight="14dp"
                android:paddingBottom="4dp" android:layout_marginBottom="10dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:gravity="center_vertical"
                    android:paddingTop="12dp" android:paddingBottom="4dp">
                    <View android:layout_width="3dp" android:layout_height="14dp"
                        android:background="@drawable/bg_taobao_btn" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="基本信息" android:textSize="15sp" android:textStyle="bold"
                        android:textColor="@color/text" android:layout_marginLeft="6dp" />
                </LinearLayout>

                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="商品名称" android:textSize="12sp"
                    android:textColor="@color/text_secondary" />
                <EditText android:id="@+id/etAddName"
                    android:layout_width="match_parent" android:layout_height="44dp"
                    android:hint="请输入商品名称" android:textSize="14sp" android:maxLength="60"
                    android:textColor="@color/text" android:textColorHint="@color/text_secondary"
                    android:background="@android:color/transparent" />
                <View android:layout_width="match_parent" android:layout_height="1dp"
                    android:background="@color/border" />

                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="商品分类" android:textSize="12sp"
                    android:textColor="@color/text_secondary" android:layout_marginTop="2dp" />
                <EditText android:id="@+id/etAddCategory"
                    android:layout_width="match_parent" android:layout_height="44dp"
                    android:hint="如：数码、家居（可填，默认生活）" android:textSize="14sp" android:maxLength="20"
                    android:textColor="@color/text" android:textColorHint="@color/text_secondary"
                    android:background="@android:color/transparent" />
            </LinearLayout>

            <!-- 销售信息 -->
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:background="@color/surface"
                android:paddingLeft="14dp" android:paddingRight="14dp"
                android:paddingBottom="4dp" android:layout_marginBottom="10dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:gravity="center_vertical"
                    android:paddingTop="12dp" android:paddingBottom="4dp">
                    <View android:layout_width="3dp" android:layout_height="14dp"
                        android:background="@drawable/bg_taobao_btn" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="销售信息" android:textSize="15sp" android:textStyle="bold"
                        android:textColor="@color/text" android:layout_marginLeft="6dp" />
                </LinearLayout>

                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="商品价格" android:textSize="12sp"
                    android:textColor="@color/text_secondary" />
                <LinearLayout android:layout_width="match_parent" android:layout_height="44dp"
                    android:orientation="horizontal" android:gravity="center_vertical">
                    <EditText android:id="@+id/etAddPrice" android:layout_width="0dp"
                        android:layout_height="match_parent" android:layout_weight="1"
                        android:hint="请输入价格" android:textSize="14sp"
                        android:inputType="numberDecimal" android:maxLength="10"
                        android:textColor="@color/text" android:textColorHint="@color/text_secondary"
                        android:background="@android:color/transparent" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="元" android:textSize="12sp"
                        android:textColor="@color/text_secondary" />
                </LinearLayout>
                <View android:layout_width="match_parent" android:layout_height="1dp"
                    android:background="@color/border" />

                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="库存数量" android:textSize="12sp"
                    android:textColor="@color/text_secondary" android:layout_marginTop="2dp" />
                <LinearLayout android:layout_width="match_parent" android:layout_height="44dp"
                    android:orientation="horizontal" android:gravity="center_vertical">
                    <EditText android:id="@+id/etAddStock" android:layout_width="0dp"
                        android:layout_height="match_parent" android:layout_weight="1"
                        android:hint="请输入库存" android:textSize="14sp"
                        android:inputType="number" android:maxLength="8"
                        android:textColor="@color/text" android:textColorHint="@color/text_secondary"
                        android:background="@android:color/transparent" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="件" android:textSize="12sp"
                        android:textColor="@color/text_secondary" />
                </LinearLayout>
            </LinearLayout>

            <!-- 商品描述 -->
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:background="@color/surface"
                android:paddingLeft="14dp" android:paddingRight="14dp"
                android:paddingBottom="12dp" android:layout_marginBottom="10dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:gravity="center_vertical"
                    android:paddingTop="12dp" android:paddingBottom="4dp">
                    <View android:layout_width="3dp" android:layout_height="14dp"
                        android:background="@drawable/bg_taobao_btn" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="商品描述" android:textSize="15sp" android:textStyle="bold"
                        android:textColor="@color/text" android:layout_marginLeft="6dp" />
                </LinearLayout>

                <EditText android:id="@+id/etAddDesc"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:hint="介绍一下这件商品的特点、材质、用途…" android:textSize="14sp" android:maxLength="500"
                    android:minLines="4" android:gravity="top"
                    android:textColor="@color/text" android:textColorHint="@color/text_secondary"
                    android:background="@android:color/transparent" />
            </LinearLayout>

            <TextView android:id="@+id/btnAddSave" android:layout_width="match_parent"
                android:layout_height="46dp" android:layout_marginTop="2dp" android:layout_marginBottom="10dp"
                android:text="保存" android:textSize="16sp" android:textColor="#FFFFFF"
                android:gravity="center" android:background="@drawable/bg_taobao_btn" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
