<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:background="@color/bg">

    <!-- 顶栏 -->
    <LinearLayout android:layout_width="match_parent" android:layout_height="52dp"
        android:orientation="horizontal" android:gravity="center_vertical"
        android:background="@color/surface" android:paddingLeft="4dp" android:paddingRight="12dp">
        <ImageButton android:id="@+id/btnShopBack"
            android:layout_width="40dp" android:layout_height="40dp"
            android:src="@drawable/ic_back" android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="返回" />
        <TextView android:id="@+id/tvShopName"
            android:layout_width="0dp" android:layout_height="match_parent"
            android:layout_weight="1" android:text="店铺" android:textSize="17sp"
            android:textColor="@color/text" android:gravity="center_vertical"
            android:paddingLeft="4dp" android:maxLines="1" android:ellipsize="end" />
    </LinearLayout>

    <View android:layout_width="match_parent" android:layout_height="1dp"
        android:background="@color/border" />

    <!-- 店铺信息头部 -->
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:gravity="center_vertical"
        android:background="@color/surface" android:padding="14dp">
        <ImageView android:layout_width="40dp" android:layout_height="40dp"
            android:src="@drawable/ic_shop" android:contentDescription="店铺" />
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:orientation="vertical" android:paddingLeft="10dp">
            <TextView android:id="@+id/tvShopTitle"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:textSize="16sp" android:textColor="@color/text" android:textStyle="bold" />
            <TextView android:id="@+id/tvShopCount"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:textSize="12sp" android:textColor="@color/text_secondary"
                android:layout_marginTop="2dp" />
        </LinearLayout>
    </LinearLayout>

    <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
        android:id="@+id/swipeShop"
        android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvShopProducts"
            android:layout_width="match_parent" android:layout_height="match_parent"
            android:clipToPadding="false" android:paddingBottom="4dp"
            android:overScrollMode="never" />
    </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>
</LinearLayout>
