<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:background="@color/bg">

    <!-- 顶栏 -->
    <LinearLayout android:layout_width="match_parent" android:layout_height="52dp"
        android:orientation="horizontal" android:gravity="center_vertical"
        android:background="@color/surface" android:paddingLeft="4dp" android:paddingRight="12dp">
        <ImageButton android:id="@+id/btnReviewBack"
            android:layout_width="40dp" android:layout_height="40dp"
            android:src="@drawable/ic_back" android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="返回" />
        <TextView android:layout_width="0dp" android:layout_height="match_parent"
            android:layout_weight="1" android:text="发表评价" android:textSize="17sp"
            android:textColor="@color/text" android:gravity="center_vertical" android:paddingLeft="4dp" />
        <TextView android:id="@+id/btnReviewSubmit"
            android:layout_width="wrap_content" android:layout_height="match_parent"
            android:text="提交" android:textSize="15sp" android:textColor="@color/taobao_orange"
            android:gravity="center" android:paddingLeft="10dp"
            android:background="?attr/selectableItemBackgroundBorderless" />
    </LinearLayout>

    <View android:layout_width="match_parent" android:layout_height="1dp"
        android:background="@color/border" />

    <!-- 商品信息 -->
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:gravity="center_vertical"
        android:background="@color/surface" android:padding="12dp">
        <TextView android:id="@+id/tvReviewProduct"
            android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:textSize="14sp" android:textColor="@color/text"
            android:maxLines="2" android:ellipsize="end" />
    </LinearLayout>

    <!-- 星级 -->
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:gravity="center_horizontal"
        android:background="@color/surface" android:layout_marginTop="1dp"
        android:paddingTop="18dp" android:paddingBottom="18dp">
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="商品质量如何？" android:textSize="13sp" android:textColor="@color/text_secondary" />
        <LinearLayout android:id="@+id/rowStars"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:orientation="horizontal" android:layout_marginTop="8dp" />
    </LinearLayout>

    <!-- 评价内容 -->
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:background="@color/surface"
        android:layout_marginTop="1dp" android:padding="12dp">
        <EditText android:id="@+id/etReviewContent"
            android:layout_width="match_parent" android:layout_height="120dp"
            android:hint="说说商品的优点或不足吧（选填）" android:textSize="14sp"
            android:textColor="@color/text" android:textColorHint="@color/text_secondary"
            android:gravity="top" android:inputType="textMultiLine"
            android:background="@drawable/bg_search_input" android:padding="10dp" />
    </LinearLayout>
</LinearLayout>
