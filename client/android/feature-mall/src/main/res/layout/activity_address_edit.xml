<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:background="@color/bg">

    <!-- 顶栏 -->
    <LinearLayout android:layout_width="match_parent" android:layout_height="52dp"
        android:orientation="horizontal" android:gravity="center_vertical"
        android:background="@color/surface" android:paddingLeft="4dp" android:paddingRight="12dp">
        <ImageButton android:id="@+id/btnAddrEditBack"
            android:layout_width="40dp" android:layout_height="40dp"
            android:src="@drawable/ic_back" android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="返回" />
        <TextView android:id="@+id/tvAddrEditTitle"
            android:layout_width="0dp" android:layout_height="match_parent"
            android:layout_weight="1" android:text="新增地址" android:textSize="17sp"
            android:textColor="@color/text" android:gravity="center_vertical" android:paddingLeft="4dp" />
        <TextView android:id="@+id/btnAddrEditSave"
            android:layout_width="wrap_content" android:layout_height="match_parent"
            android:text="保存" android:textSize="15sp" android:textColor="@color/taobao_orange"
            android:gravity="center" android:paddingLeft="10dp"
            android:background="?attr/selectableItemBackgroundBorderless" />
    </LinearLayout>

    <View android:layout_width="match_parent" android:layout_height="1dp"
        android:background="@color/border" />

    <!-- 表单 -->
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:background="@color/surface"
        android:layout_marginTop="12dp" android:paddingLeft="16dp" android:paddingRight="16dp">

        <EditText android:id="@+id/etAddrName"
            android:layout_width="match_parent" android:layout_height="52dp"
            android:hint="收货人姓名" android:textSize="15sp" android:textColor="@color/text"
            android:textColorHint="@color/text_secondary" android:background="@null"
            android:singleLine="true" />
        <View android:layout_width="match_parent" android:layout_height="1dp"
            android:background="@color/border" />
        <EditText android:id="@+id/etAddrPhone"
            android:layout_width="match_parent" android:layout_height="52dp"
            android:hint="手机号" android:textSize="15sp" android:textColor="@color/text"
            android:textColorHint="@color/text_secondary" android:background="@null"
            android:singleLine="true" android:inputType="phone" />
        <View android:layout_width="match_parent" android:layout_height="1dp"
            android:background="@color/border" />
        <EditText android:id="@+id/etAddrDetail"
            android:layout_width="match_parent" android:layout_height="72dp"
            android:hint="详细地址（省市区 + 街道门牌）" android:textSize="15sp"
            android:textColor="@color/text" android:textColorHint="@color/text_secondary"
            android:background="@null" android:gravity="top"
            android:inputType="textMultiLine" android:maxLines="3" />
    </LinearLayout>

    <CheckBox android:id="@+id/ckAddrDefault"
        android:layout_width="match_parent" android:layout_height="52dp"
        android:layout_marginTop="12dp" android:background="@color/surface"
        android:paddingLeft="16dp" android:text="设为默认地址" android:textSize="14sp"
        android:textColor="@color/text" android:buttonTint="@color/taobao_orange" />
</LinearLayout>
