<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:background="@color/bg">

    <!-- 顶栏 -->
    <LinearLayout android:layout_width="match_parent" android:layout_height="52dp"
        android:orientation="horizontal" android:gravity="center_vertical"
        android:background="@color/surface">
        <ImageButton android:id="@+id/btnCheckoutBack"
            android:layout_width="40dp" android:layout_height="40dp"
            android:src="@drawable/ic_back" android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="返回" />
        <TextView android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:text="确认订单" android:textSize="17sp"
            android:textColor="@color/text" android:gravity="center" />
        <View android:layout_width="40dp" android:layout_height="40dp" />
    </LinearLayout>

    <ScrollView android:layout_width="match_parent" android:layout_height="0dp"
        android:layout_weight="1" android:overScrollMode="never">

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:padding="10dp">

            <!-- 收货信息 -->
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:background="@color/surface"
                android:paddingLeft="14dp" android:paddingTop="12dp" android:paddingRight="14dp"
                android:paddingBottom="4dp" android:layout_marginBottom="8dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:gravity="center_vertical"
                    android:layout_marginBottom="8dp">
                    <ImageView android:layout_width="18dp" android:layout_height="18dp"
                        android:src="@drawable/ic_location" android:contentDescription="收货信息" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="收货信息" android:textSize="15sp" android:textStyle="bold"
                        android:textColor="@color/text" android:layout_marginLeft="6dp" />
                </LinearLayout>

                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="收货人" android:textSize="12sp"
                    android:textColor="@color/text_secondary" />
                <EditText android:id="@+id/etCheckoutName"
                    android:layout_width="match_parent" android:layout_height="44dp"
                    android:hint="请填写收货人姓名" android:textSize="14sp"
                    android:textColor="@color/text" android:textColorHint="@color/text_secondary"
                    android:background="@android:color/transparent" android:maxLength="20" />
                <View android:layout_width="match_parent" android:layout_height="1dp"
                    android:background="@color/border" />

                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="手机号" android:textSize="12sp"
                    android:textColor="@color/text_secondary" android:layout_marginTop="4dp" />
                <EditText android:id="@+id/etCheckoutPhone"
                    android:layout_width="match_parent" android:layout_height="44dp"
                    android:hint="请填写手机号" android:textSize="14sp" android:inputType="phone"
                    android:textColor="@color/text" android:textColorHint="@color/text_secondary"
                    android:background="@android:color/transparent" android:maxLength="20" />
                <View android:layout_width="match_parent" android:layout_height="1dp"
                    android:background="@color/border" />

                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="详细地址" android:textSize="12sp"
                    android:textColor="@color/text_secondary" android:layout_marginTop="4dp" />
                <EditText android:id="@+id/etCheckoutAddress"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:hint="省市区 + 街道门牌号" android:textSize="14sp"
                    android:textColor="@color/text" android:textColorHint="@color/text_secondary"
                    android:background="@android:color/transparent" android:maxLength="120" />
                <View android:layout_width="match_parent" android:layout_height="1dp"
                    android:background="@color/border" android:layout_marginTop="4dp" />
                <!-- 地址簿：选择地址 / 管理地址 -->
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:gravity="center_vertical"
                    android:paddingTop="8dp" android:paddingBottom="8dp">
                    <TextView android:id="@+id/btnCheckoutPickAddr"
                        android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="从地址簿选择" android:textSize="13sp"
                        android:textColor="@color/taobao_orange"
                        android:background="?attr/selectableItemBackground" />
                    <TextView android:id="@+id/btnCheckoutManageAddr"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="管理地址" android:textSize="13sp"
                        android:textColor="@color/text_secondary"
                        android:paddingLeft="12dp" android:paddingRight="4dp"
                        android:background="?attr/selectableItemBackground" />
                </LinearLayout>
            </LinearLayout>

            <!-- 商品信息 + 价格明细 -->
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:background="@color/surface"
                android:padding="14dp" android:layout_marginBottom="8dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="商品信息" android:textSize="15sp" android:textStyle="bold"
                    android:textColor="@color/text" />
                <!-- 单商品行（兼容单商品模式） -->
                <TextView android:id="@+id/tvCheckoutName" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:textSize="15sp"
                    android:textColor="@color/text" android:layout_marginTop="8dp"
                    android:maxLines="2" android:ellipsize="end" />
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:gravity="center_vertical"
                    android:layout_marginTop="6dp">
                    <TextView android:id="@+id/tvCheckoutUnitPrice" android:layout_width="0dp"
                        android:layout_height="wrap_content" android:layout_weight="1"
                        android:textSize="13sp" android:textColor="@color/text_secondary" />
                    <TextView android:id="@+id/tvCheckoutQty" android:layout_width="wrap_content"
                        android:layout_height="wrap_content" android:textSize="13sp"
                        android:textColor="@color/text_secondary" />
                </LinearLayout>
                <!-- 多商品列表（items 模式动态填充） -->
                <LinearLayout android:id="@+id/llCheckoutItems"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="vertical" android:visibility="gone" />

                <View android:layout_width="match_parent" android:layout_height="1dp"
                    android:background="@color/border" android:layout_marginTop="12dp"
                    android:layout_marginBottom="8dp" />

                <!-- 价格明细 -->
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:gravity="center_vertical">
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:text="商品金额" android:textSize="13sp"
                        android:textColor="@color/text_secondary" />
                    <TextView android:id="@+id/tvCheckoutGoodsAmount"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:textSize="14sp" android:textColor="@color/text" />
                </LinearLayout>
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:gravity="center_vertical"
                    android:layout_marginTop="8dp">
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:text="运费" android:textSize="13sp"
                        android:textColor="@color/text_secondary" />
                    <TextView android:id="@+id/tvCheckoutFreight"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="¥0.00" android:textSize="14sp" android:textColor="@color/text" />
                </LinearLayout>
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:gravity="center_vertical"
                    android:layout_marginTop="8dp">
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:text="合计" android:textSize="13sp"
                        android:textColor="@color/text" />
                    <TextView android:id="@+id/tvCheckoutTotal"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:textSize="17sp" android:textStyle="bold"
                        android:textColor="@color/amount_red" />
                </LinearLayout>
            </LinearLayout>

            <!-- 支付方式 -->
            <LinearLayout android:layout_width="match_parent" android:layout_height="54dp"
                android:orientation="horizontal" android:gravity="center_vertical"
                android:background="@color/surface" android:paddingLeft="14dp" android:paddingRight="14dp">
                <ImageView android:layout_width="20dp" android:layout_height="20dp"
                    android:src="@drawable/ic_pay" android:contentDescription="零钱支付" />
                <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:text="零钱支付" android:textSize="14sp"
                    android:textColor="@color/text" android:layout_marginLeft="8dp" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="余额充足" android:textSize="12sp"
                    android:textColor="@color/text_secondary" android:layout_marginRight="8dp" />
                <ImageView android:layout_width="20dp" android:layout_height="20dp"
                    android:src="@drawable/ic_check_on" android:contentDescription="已选择" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <!-- 底部提交 -->
    <LinearLayout android:layout_width="match_parent" android:layout_height="56dp"
        android:orientation="horizontal" android:gravity="center_vertical"
        android:background="@color/surface" android:paddingLeft="16dp" android:paddingRight="12dp">
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="应付金额" android:textSize="13sp" android:textColor="@color/text_secondary" />
        <TextView android:id="@+id/tvCheckoutDue" android:layout_width="0dp"
            android:layout_height="wrap_content" android:layout_weight="1"
            android:textSize="17sp" android:textStyle="bold"
            android:textColor="@color/amount_red" android:layout_marginLeft="6dp" />
        <TextView android:id="@+id/btnCheckoutSubmit" android:layout_width="150dp"
            android:layout_height="44dp" android:text="提交订单并支付" android:textSize="15sp"
            android:textColor="#FFFFFF" android:gravity="center"
            android:background="@drawable/bg_taobao_btn" />
    </LinearLayout>
</LinearLayout>
