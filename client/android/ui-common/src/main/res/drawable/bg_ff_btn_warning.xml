<?xml version="1.0" encoding="utf-8"?>
<!-- 敏感按钮底：warning 描边 + warning 约 8% 淡底（转让群主） -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/warning_bg" />
            <stroke android:width="1dp" android:color="@color/warning_pressed" />
            <corners android:radius="@dimen/radius_m" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/warning_bg" />
            <stroke android:width="1dp" android:color="@color/warning" />
            <corners android:radius="@dimen/radius_m" />
        </shape>
    </item>
</selector>
