<?xml version="1.0" encoding="utf-8"?>
<!--
  群详情底部操作卡：列表行按压底 + 行底 1dp 分割线。
  分割线属于行背景的一部分，所以 Activity 把 btnTransfer 设为 GONE 时，
  该行连同分割线一起消失，不会留下两条相邻的重复分割线。
  分割线左右缩进与文字起点对齐（16dp），比通栏细线更精致。
-->
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="@color/action_row_ripple">
    <item android:id="@android:id/mask">
        <shape android:shape="rectangle">
            <solid android:color="@color/action_card_bg" />
        </shape>
    </item>
    <item>
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <solid android:color="@android:color/transparent" />
                </shape>
            </item>
            <item
                android:left="@dimen/card_padding"
                android:right="@dimen/card_padding"
                android:height="@dimen/divider_height"
                android:gravity="bottom">
                <shape android:shape="rectangle">
                    <solid android:color="@color/action_card_divider" />
                </shape>
            </item>
        </layer-list>
    </item>
</ripple>
