<?xml version="1.0" encoding="utf-8"?>
<!--
  群详情界面共用的样式（新增，纯 additive）。

  存在的理由：全仓此前没有任何 styles.xml，群详情两个界面的字号/行高/按钮底
  全部硬编码在 XML 属性和 Java 代码里。这里只抽出最小集合：文字外观 +
  卡片/分割线/列表行。底部操作已从"三级描边按钮"改为"卡片列表式"，
  对应样式见文件末尾的 Widget.FF.ActionRow.*。
  Theme.FamilyChat 不在此文件，不动。
-->
<resources>

    <!-- ═══════════ 文字外观 ═══════════ -->

    <!-- 卡片组标题：小号、次要色、字距略开（"群应用"这类分组标签） -->
    <style name="TextAppearance.FF.SectionHeader" parent="">
        <item name="android:textSize">@dimen/text_size_caption</item>
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:letterSpacing">0.02</item>
    </style>

    <!-- 行标题：正文主色 -->
    <style name="TextAppearance.FF.ItemTitle" parent="">
        <item name="android:textSize">@dimen/text_size_subtitle</item>
        <item name="android:textColor">@color/on_surface</item>
    </style>

    <!-- 行右侧值 / 行副标题：次要色 -->
    <style name="TextAppearance.FF.ItemValue" parent="">
        <item name="android:textSize">@dimen/text_size_caption</item>
        <item name="android:textColor">@color/text_secondary</item>
    </style>

    <!-- ═══════════ 容器 ═══════════ -->

    <!-- 圆角卡片：群资料卡、各分组卡片。不带 elevation（夜间 elevation 着色不可靠），
         层级靠 card_bg 与 bg 的明度差。 -->
    <style name="Widget.FF.Card" parent="">
        <item name="android:background">@drawable/bg_ff_card</item>
        <item name="android:orientation">vertical</item>
    </style>

    <!-- 卡片内分割线：只描述外观。
         ⚠️ 宽度/高度/缩进是"使用位置的布局参数"，一律由使用处给（见
         activity_group_detail.xml 的成员卡分隔线），style 里不写 layout_*：
         写在这里会让每个使用者都必须覆盖，忘了就静默出错（Button.Danger 的
         layout_width=0dp 就是这个坑的实例）。当前无人引用本 style。 -->
    <style name="Widget.FF.Divider" parent="">
        <item name="android:background">@color/divider</item>
    </style>

    <!-- 行内装饰图标：只描述外观（尺寸与间距由使用处给）。
         与 Divider 同理，style 里不写 layout_*。当前无人引用本 style。 -->
    <style name="Widget.FF.ItemIcon" parent="">
        <item name="android:scaleType">fitCenter</item>
    </style>

    <!-- ═══════════ 群详情底部操作卡（卡片列表式）═══════════
         三个操作不再是三个实心/描边大按钮，而是同一张圆角卡片里的列表行：
         常规项左对齐 + 右侧 chevron，危险项（解散/退出）居中危险红。
         行背景只负责按压涟漪与行底 1dp 分割线，卡片圆角由外层
         MaterialCardView 统一裁剪。宽/高仍由使用处的 layout 给，style 不写 layout_*。 -->

    <style name="Widget.FF.ActionRow" parent="">
        <item name="android:textSize">@dimen/text_size_subtitle</item>
        <item name="android:textColor">@color/on_surface</item>
        <item name="android:textStyle">normal</item>
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:gravity">start|center_vertical</item>
        <item name="android:paddingStart">@dimen/card_padding</item>
        <item name="android:paddingEnd">@dimen/card_padding</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:minHeight">0dp</item>
        <item name="android:stateListAnimator">@null</item>
        <!-- 防止主题 buttonStyle 的 backgroundTint 把行背景染色 -->
        <item name="android:backgroundTint">@null</item>
        <item name="android:drawableEnd">@drawable/ic_chevron_right</item>
        <item name="android:drawablePadding">@dimen/spacing_s</item>
        <item name="android:background">@drawable/bg_ff_action_row</item>
    </style>

    <!-- 带行底分割线的行（非末行）：btnTransfer 为 GONE 时线随行一起消失 -->
    <style name="Widget.FF.ActionRow.Divider">
        <item name="android:background">@drawable/bg_ff_action_row_divider</item>
    </style>

    <!-- 危险行：居中、危险红、无 chevron -->
    <style name="Widget.FF.ActionRow.Danger">
        <item name="android:textColor">@color/action_danger_text</item>
        <item name="android:gravity">center</item>
        <item name="android:drawableEnd">@null</item>
    </style>

</resources>
