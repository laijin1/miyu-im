    <color name="danger">#FF6369</color>
    <color name="danger_pressed">#E04A50</color>
    <color name="danger_bg">#1FFF6369</color>
    <color name="warning">#FFB224</color>
    <color name="warning_pressed">#E09A18</color>
    <color name="warning_bg">#1FFFB224</color>
    <!-- 夜间卡片底：比 bg(#000) 亮一档，否则卡片与页面无层级 -->
