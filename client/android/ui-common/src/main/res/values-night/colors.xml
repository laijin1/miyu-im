    <color name="text_secondary">#AAAAAA</color>
    <color name="border">#1A1A1A</color>
    <color name="chat_bg">#000000</color>
    <color name="black_overlay">#99000000</color>

    <!-- 聊天"+": 面板背景（黑夜深灰）与通话图标蓝 -->
    <color name="panel_bg">#1F1F1F</color>
    <color name="panel_call_icon">#2196F3</color>

    <!-- 主页"+"下拉菜单：卡片背景（黑夜深灰）、分隔线与文字 -->
    <color name="menu_card_bg">#2A2A2A</color>
    <color name="menu_border">#3A3A3A</color>

    <!-- 图标：黑夜下着白色 -->
    <color name="icon">#FFFFFF</color>
    <color name="icon_nav_selected">#2196F3</color>
    <color name="icon_nav_unselected">#8A8A8A</color>

    <!-- 聊天气泡：黑夜下深色背景 + 白字 -->
    <color name="bubble_self">#1E1E1E</color>
    <color name="bubble_other">#1E1E1E</color>
    <color name="bubble_text_self">#FFFFFF</color>
    <color name="bubble_text_other">#FFFFFF</color>
    <color name="bubble_voice">#1E1E1E</color>
    <color name="bubble_voice_text">#FFFFFF</color>
    <!-- 通话记录气泡：夜间与其它气泡同为深底白字（夜间本来 bubble_self == bubble_other）。
         图标 ic_phone/ic_video 是黑色字形，必须靠 bubble_call_text 着色才可见 -->
    <color name="bubble_call">#1E1E1E</color>
    <color name="bubble_call_text">#FFFFFF</color>
    <color name="voice_wave_other">#FFFFFF</color>
    <color name="reject_bg">#3A3A3A</color>

    <!-- 语音播放按钮：黑夜灰色底 + 白图标 -->
    <color name="play_btn_bg">#888888</color>
    <color name="play_icon">#FFFFFF</color>

    <!-- 支付数字键盘（自写）：黑夜深键 + 白字 -->
    <color name="keypad_bg">#1F1F1F</color>
    <color name="keypad_key_bg">#2A2A2A</color>
    <color name="keypad_key_pressed">#3A3A3A</color>
    <color name="keypad_key_text">#FFFFFF</color>

    <!-- 金额显示（键盘联动）：黑夜空态灰 / 白 -->
    <color name="amount_empty">#8A8A8A</color>
    <color name="amount_value">#FFFFFF</color>

    <!-- 付款码白卡：黑夜深卡 + 深描边 -->
    <color name="qr_card_bg">#2A2A2A</color>
    <color name="qr_card_border">#3A3A3A</color>

    <!-- 支付密码方格：黑夜深底 -->
    <color name="pwd_box_bg">#1F1F1F</color>
    <color name="pwd_box_stroke">#3A3A3A</color>

